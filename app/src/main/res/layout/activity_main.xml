<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#0B1220" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="28dp" android:paddingBottom="28dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="鼾声守护" android:textColor="#F2F6FC" android:textSize="30sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="让白噪声，刚刚好。" android:textColor="#93A4BA" android:textSize="15sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:background="@drawable/card" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pill" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="本地检测 · 不保存录音" android:textColor="#72E6C1" android:textSize="12sp"/>
<TextView android:id="@+id/statusTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="准备就绪" android:textColor="#F2F6FC" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:id="@+id/statusDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:text="先打开网易云播放白噪声，再开始检测。\n只调整媒体音量，不会暂停或控制播放。" android:textColor="#93A4BA" android:textSize="14sp"/>
<TextView android:id="@+id/volumeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="媒体音量 —" android:textColor="#72E6C1" android:textSize="16sp" android:textStyle="bold"/>
<ProgressBar android:id="@+id/levelBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressTint="#72E6C1" android:progressBackgroundTint="#26364C"/>
<TextView android:id="@+id/levelText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="启动后先学习环境底噪约 2 秒" android:textColor="#93A4BA" android:textSize="12sp"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" android:text="检测设置" android:textColor="#F2F6FC" android:textSize="18sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="麦克风来源" android:textColor="#F2F6FC" android:textSize="15sp" android:textStyle="bold"/>
<Spinner android:id="@+id/micSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="#1B2A40" android:paddingLeft="12dp" android:paddingRight="12dp"/>
<TextView android:id="@+id/micHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="使用耳机播放时，仍通过手机内置麦克风检测。" android:textColor="#93A4BA" android:textSize="12sp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/sensitivityLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="检测灵敏度 · 标准" android:textColor="#F2F6FC" android:textSize="15sp" android:textStyle="bold"/>
<SeekBar android:id="@+id/sensitivitySeek" android:layout_width="match_parent" android:layout_height="48dp" android:max="4" android:progress="2" android:progressTint="#72E6C1" android:thumbTint="#72E6C1"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="白噪声较大时建议调低；漏检时再逐步提高。" android:textColor="#93A4BA" android:textSize="12sp"/>
<TextView android:id="@+id/stepLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="每次提高 · 2 格" android:textColor="#F2F6FC" android:textSize="15sp" android:textStyle="bold"/>
<SeekBar android:id="@+id/stepSeek" android:layout_width="match_parent" android:layout_height="48dp" android:max="4" android:progress="1" android:progressTint="#72E6C1" android:thumbTint="#72E6C1"/>
<TextView android:id="@+id/capLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="最高音量 · 70%" android:textColor="#F2F6FC" android:textSize="15sp" android:textStyle="bold"/>
<SeekBar android:id="@+id/capSeek" android:layout_width="match_parent" android:layout_height="48dp" android:max="6" android:progress="3" android:progressTint="#72E6C1" android:thumbTint="#72E6C1"/>
<TextView android:id="@+id/restoreLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="无鼾声后恢复 · 90 秒" android:textColor="#F2F6FC" android:textSize="15sp" android:textStyle="bold"/>
<SeekBar android:id="@+id/restoreSeek" android:layout_width="match_parent" android:layout_height="48dp" android:max="5" android:progress="2" android:progressTint="#72E6C1" android:thumbTint="#72E6C1"/>
</LinearLayout>
<Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:background="@drawable/button_primary" android:text="开始检测" android:textAllCaps="false" android:textColor="#0B2924" android:textSize="17sp" android:textStyle="bold"/>
<Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:background="@drawable/button_stop" android:enabled="false" android:text="停止并恢复音量" android:textAllCaps="false" android:textColor="#F2B4C2" android:textSize="16sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:lineSpacingExtra="3dp" android:text="使用提示\n• 手机放在床边，内置麦克风不要被遮挡。\n• 锁屏后由前台服务持续检测，状态栏会显示通知。\n• 属于声音特征判断，可能误判，不是医疗诊断。\n• 部分机型需在系统设置中允许后台运行或关闭电池限制。" android:textColor="#93A4BA" android:textSize="12sp"/>
</LinearLayout></ScrollView>
