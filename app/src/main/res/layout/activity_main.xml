<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C111B"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="鼾声守护"
            android:textColor="#F5F7FA"
            android:textSize="34sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="检测到鼾声，白噪声再响一点。"
            android:textColor="#9BA8BC"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="准备就绪"
                android:textColor="#F5F7FA"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="不会暂停、静音或控制网易云"
                android:textColor="#9BA8BC"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="媒体音量"
                android:textColor="#8BD5CA"
                android:textSize="16sp" />
        </LinearLayout>
        <TextView
            style="@style/SectionTitle"
            android:text="检测与音量" />
        <CheckBox
            android:id="@+id/builtInMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="固定使用手机内置麦克风（推荐戴耳机时开启）"
            android:textColor="#DDE4EE"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="开始检测后先记录约 2 秒背景 dB 平均值。识别到疑似鼾声才逐格提高媒体音量；连续安静后逐格恢复。"
            android:textColor="#9BA8BC"
            android:textSize="13sp" />
        <TextView android:id="@+id/sensitivityValue" style="@style/SettingLabel" />
        <SeekBar android:id="@+id/sensitivity" style="@style/SettingSlider" />
        <TextView android:id="@+id/stepValue" style="@style/SettingLabel" />
        <SeekBar android:id="@+id/step" style="@style/SettingSlider" />
        <TextView android:id="@+id/capValue" style="@style/SettingLabel" />
        <SeekBar android:id="@+id/cap" style="@style/SettingSlider" />
        <TextView android:id="@+id/quietValue" style="@style/SettingLabel" />
        <SeekBar android:id="@+id/quiet" style="@style/SettingSlider" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="提高和恢复均每 1.5 秒最多变化 1 格。提高受音量上限约束，10 秒内不重复发起。请先用目标增幅 1–2 格、上限 50–70% 试用，避免影响听力或他人。"
            android:textColor="#9BA8BC"
            android:textSize="13sp" />
        <Button
            android:id="@+id/startButton"
            style="@style/PrimaryButton"
            android:layout_marginTop="24dp"
            android:text="开始检测" />
        <Button
            android:id="@+id/stopButton"
            style="@style/PrimaryButton"
            android:enabled="false"
            android:text="停止并逐格恢复音量" />
        <Button
            android:id="@+id/logButton"
            style="@style/PrimaryButton"
            android:background="@drawable/button_secondary"
            android:text="查看夜间日志" />
        <Button
            android:id="@+id/privacyButton"
            style="@style/PrimaryButton"
            android:background="@drawable/button_secondary"
            android:text="隐私与日志管理" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:text="锁屏与后台检测期间会显示常驻通知。只记录事件和 dB，不保存或上传录音。首次使用请确认手机系统没有限制本应用的后台运行。"
            android:textColor="#7F8CA0"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
